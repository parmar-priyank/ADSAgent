# Copy this file to ".env" and fill in your real values.

# Your Anthropic API key (required) — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the default Claude model
CLAUDE_MODEL=claude-haiku-4-5-20251001

DB_PATH=extractions.db
SECRET_KEY=

# SMTP settings for email verification and password reset (optional but recommended)
# For Gmail: use an App Password (not your main password), SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=ADS Agent <your_email@gmail.com>
