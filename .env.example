# Copy this file to ".env" and fill in your real values.

# Your Anthropic API key (required) — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the default Claude model
CLAUDE_MODEL=claude-haiku-4-5-20251001

DB_PATH=extractions.db
SECRET_KEY=

# Security — set both to "true" on a production HTTPS server
COOKIE_SECURE=false
HSTS_ENABLED=false

# SMTP settings for email verification, password reset, and login 2FA codes
# (optional but recommended). Works with any standard SMTP provider — pick one:
#
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASSWORD=your_app_password_here   (Google Account > Security > App Passwords —
#                                            requires 2-Step Verification enabled on the account)
#
# Outlook / Office365 / Microsoft 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@outlook.com        (or your Microsoft 365 business address)
#   SMTP_PASSWORD=your_app_password_here    (Microsoft account > Security > App passwords —
#                                            requires 2-Step Verification enabled; for
#                                            Microsoft 365 business accounts your admin may
#                                            need to enable SMTP AUTH for the mailbox first)
#
# Only one provider can be active at a time — fill in the values below for
# whichever one you're using.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=ADS Agent <your_email@gmail.com>

# Optional: email address to receive the weekly database backup
# (deploy/backup_db.sh + deploy/email_backup.py). Leave blank to skip
# emailing backups — the local backup in backups/ still happens either way.
BACKUP_EMAIL_TO=
