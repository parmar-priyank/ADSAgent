# Copy this file to ".env" and fill in your real values.

# Your Anthropic API key (required) — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the default Claude model
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Per-million-token USD price for CLAUDE_MODEL — used only to estimate the $
# cost shown per QC run. Update these whenever you change CLAUDE_MODEL or
# Anthropic changes its pricing (check https://www.anthropic.com/pricing).
# Values below are Claude Sonnet 5's introductory rate through 2026-08-31.
CLAUDE_PRICE_PER_M_INPUT=2.0
CLAUDE_PRICE_PER_M_OUTPUT=10.0

# How many Claude calls one checklist run may have in flight at once.
# A 49-item template previously queued behind Python's default 6-thread
# executor; raising this is what makes a ZIP run finish faster. Higher is
# not always better — too high and Anthropic returns 429 rate-limit errors,
# turning a slow run into a failing one. Raise gradually and watch the logs.
CLAUDE_MAX_CONCURRENCY=12

DB_PATH=extractions.db
SECRET_KEY=

# Security — defaults assume a production HTTPS server (the normal case,
# since deploy/setup.sh installs nginx + certbot for HTTPS). Set BOTH to
# "false" only for local HTTP development (e.g. running `python main.py`
# directly on your own machine without HTTPS) — with COOKIE_SECURE=true
# over plain HTTP, browsers silently drop the session cookie and login
# will appear to fail for no visible reason.
COOKIE_SECURE=true
HSTS_ENABLED=true

# SMTP settings for email verification, password reset, and login 2FA codes
# (optional but recommended). Works with any standard SMTP provider — pick one:
#
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASSWORD=your_app_password_here   (Google Account > Security > App Passwords —
#                                            requires 2-Step Verification enabled on the account)
#
# Outlook / Office365 / Microsoft 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@outlook.com        (or your Microsoft 365 business address)
#   SMTP_PASSWORD=your_app_password_here    (Microsoft account > Security > App passwords —
#                                            requires 2-Step Verification enabled; for
#                                            Microsoft 365 business accounts your admin may
#                                            need to enable SMTP AUTH for the mailbox first)
#
# Only one provider can be active at a time — fill in the values below for
# whichever one you're using.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=ADS Agent <your_email@gmail.com>

# Optional: email address to receive the weekly database backup
# (deploy/backup_db.sh + deploy/email_backup.py). Leave blank to skip
# emailing backups — the local backup in backups/ still happens either way.
BACKUP_EMAIL_TO=

# ---------------------------------------------------------------------------
# Retailer (your company) identity — used by the PDF extraction prompt
# ---------------------------------------------------------------------------
# These tell the AI which details belong to ADS Solar, so it never files them
# under the customer's fields when reading a signed agreement. Change them
# here + restart the service if a contact person changes, the office moves, or
# the sales email changes — no code edit or redeploy needed.
# Leave any of them unset to keep the built-in default shown below.
RETAILER_NAME=ADS Pty Ltd t/as ADS Solar
RETAILER_CONTACT_PERSON=Nik
RETAILER_EMAIL=sales@adssolar.com.au
# Short forms, as phrased in the extraction prompt itself:
RETAILER_POSTAL_ADDRESS=PO Box 6208 / Norwest
RETAILER_STREET_ADDRESS=Solent Circuit, Baulkham Hills
# Full forms with postcode, used as examples in the field descriptions:
RETAILER_POSTAL_ADDRESS_FULL=PO Box 6208, Norwest NSW 2153
RETAILER_STREET_ADDRESS_FULL=104, 29-31 Solent Circuit, Baulkham Hills NSW 2153
# Described as a pattern rather than an exact number:
RETAILER_PHONE_HINT=a 1300 number

# Comma-separated list of IPs allowed to reach /login, used ONLY when an admin
# has switched on the "restrict user login by IP" toggle in the admin panel
# (that toggle is off by default, so this list is ignored until it's turned on).
# Edit this list and restart the service to change the allowed offices — no
# code change needed. Leave it unset/blank to keep the built-in defaults.
LOGIN_ALLOWED_IPS=103.233.116.210,139.5.251.232

# CSRF protection enforcement.
#
# Leave as "false" (the default) to run in LOG-ONLY mode: any request that
# fails the CSRF check is written to the log with the path and reason, but is
# NOT blocked. Deploy in this mode first, use the app normally for a day, then
# check for "CSRF would block" lines:
#
#   grep "CSRF would block" logs/app.log
#
# Each line ends with had_cookie=, which tells you which kind of failure it is:
#
#   had_cookie=True  + "no csrf_token field in form"
#       A page that was already open in someone's browser when the deploy
#       happened: their cached HTML predates the token field. HARMLESS —
#       reloading that tab fixes it permanently. The referer= in the line
#       names the page, and user= names who hit it.
#
#   had_cookie=False
#       The request carried no CSRF cookie at all. This is the one worth
#       investigating before enabling enforcement.
#
# Once the only entries are had_cookie=True ones whose tabs have since been
# reloaded, set this to true and restart to start rejecting forged requests.
CSRF_ENFORCE=false
